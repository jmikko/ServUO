<?xml version="1.0" encoding="utf-8"?>
<!--
    Wondrous items: the SRD magic items whose whole effect is a standing bonus while worn.

    These are rows in a table for the same reason the weapons and armour are - a Ring of Protection
    is not a behaviour, it is +1 to armour class and +1 to saves, and writing fifty lines of C# per
    such item buys nothing. Items that actually *do* something on use (potions, wands, a bag of
    holding) are not here; they need code and belong in their own file.

    attunement  true if the bonuses only apply while attuned. Three attuned items is the limit.
    ac/attack/damage/save  flat bonuses, applied while worn.
    str..cha    an ability score the item *sets* if it is higher than your own - not a bonus. This is
                how the SRD writes Gauntlets of Ogre Power and the Amulet of Health, and it is why
                they are worth less to a character who already has the score.
    layer       the paperdoll slot. Two items on the same layer cannot both be worn, which is the
                only balancing this table does.
-->
<magicitems>

  <!-- ===== Rings ===== -->
  <item id="RingOfProtection"    name="a Ring of Protection"       attunement="true"  ac="1" save="1"                      itemID="0x108A" layer="Ring"       hue="1150" weight="0.1" cost="350000" />
  <item id="RingOfEvasion"       name="a Ring of Evasion"          attunement="true"  save="2"                             itemID="0x108A" layer="Ring"       hue="1153" weight="0.1" cost="400000" />
  <item id="RingOfFreeAction"    name="a Ring of Free Action"      attunement="true"  save="1"                             itemID="0x108A" layer="Ring"       hue="1109" weight="0.1" cost="300000" />

